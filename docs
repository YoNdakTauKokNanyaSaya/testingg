	Name = "Simpan",
	Icon = "lucide:save",
	Callback = function()
		local saved = Library:SaveConfig(cfgName)
		cfgList:Refresh(Library:ListConfigs())
		Library:Notify({
			Title = saved and "Config tersimpan" or "Gagal menyimpan",
			Content = cfgName,
			Type = saved and "Success" or "Error",
		})
	end,
})

CfgSec:CreateButton({
	Name = "Muat",
	Icon = "lucide:folder-open",
	Callback = function()
		local loaded = Library:LoadConfig(cfgName)
		Library:Notify({
			Title = loaded and "Config dimuat" or "Config tidak ditemukan",
			Content = cfgName,
			Type = loaded and "Success" or "Warning",
		})
	end,
})

CfgSec:CreateButton({
	Name = "Hapus",
	Icon = "lucide:trash-2",
	Callback = function()
		Library:DeleteConfig(cfgName)
		cfgList:Refresh(Library:ListConfigs())
		Library:Notify({ Title = "Config dihapus", Content = cfgName, Type = "Info" })
	end,
})

