----------------------------------------------------------------------
-- ANIMATION PRESETS
----------------------------------------------------------------------
local EASE = {
	Instant = TweenInfo.new(0),
	Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Smooth = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Spring = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	Slow = TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
}

local function tween(obj, props, info)
	local t = TweenService:Create(obj, info or EASE.Smooth, props)
	t:Play()
	return t
end

----------------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------------
local function create(class, props, children)
	local inst = Instance.new(class)

	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	if inst:IsA("GuiButton") then
		inst.AutoButtonColor = false
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		inst.Font = Enum.Font.BuilderSansMedium
		inst.TextColor3 = Theme.Text
		inst.TextSize = 14
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") then
		inst.Text = ""
		inst.BackgroundTransparency = 1
	end
	if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
		inst.BackgroundTransparency = 1
	end

	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
	return create("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function padding(parent, l, t, r, b)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0),
		Parent = parent,
	})
end

local function listLayout(parent, gap)
	return create("UIListLayout", {
		Padding = UDim.new(0, gap or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

local function safe(fn, ...)
	if typeof(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[NebulaUI] Callback error: " .. tostring(err))
	end
end

local function round(n, inc)
	inc = (inc and inc > 0) and inc or 1
	local r = math.floor(n / inc + 0.5) * inc
	return tonumber(string.format("%.6g", r))
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local function mountGui(gui)
	local host
	local ok = pcall(function()
		host = (typeof(gethui) == "function" and gethui()) or CoreGui
		local old = host:FindFirstChild(gui.Name)
		if old then
			old:Destroy()
		end
		gui.Parent = host
	end)
	if not ok or not gui.Parent then
		local pg = LocalPlayer:WaitForChild("PlayerGui")
		local old = pg:FindFirstChild(gui.Name)
		if old then
			old:Destroy()
		end
		gui.Parent = pg
	end
end

-- Efek ripple saat klik
local function ripple(frame, input)
	local p = Vector2.new(input.Position.X, input.Position.Y) - frame.AbsolutePosition
	local dot = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(p.X, p.Y),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 0.72,
		ZIndex = 2,
		Parent = frame,
	})
	corner(dot, 999)
	local d = math.max(frame.AbsoluteSize.X, frame.AbsoluteSize.Y) * 2.2
	tween(dot, {
		Size = UDim2.fromOffset(d, d),
		BackgroundTransparency = 1,
	}, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
	task.delay(0.65, function()
		dot:Destroy()
	end)
end

----------------------------------------------------------------------
-- CONFIG (serialize)
----------------------------------------------------------------------
local function encode(v)
	local t = typeof(v)
	if t == "Color3" then
		return { __t = "Color3", r = v.R, g = v.G, b = v.B }
	elseif t == "EnumItem" then
		return { __t = "Key", name = v.Name }
	end
	return v
end

local function decode(v)
	if type(v) == "table" and v.__t == "Color3" then
		return Color3.new(v.r, v.g, v.b)
	elseif type(v) == "table" and v.__t == "Key" then
		return Enum.KeyCode[v.name]
	end
	return v
end

local CONFIG_DIR = "NebulaUI"

function Library:SaveConfig(name)
	name = name or "default"
	local ok, err = pcall(function()
		local data = {}
		for flag, value in pairs(self.Flags) do
			data[flag] = encode(value)
		end
		if isfolder and not isfolder(CONFIG_DIR) then
			makefolder(CONFIG_DIR)
		end
		writefile(CONFIG_DIR .. "/" .. name .. ".json", HttpService:JSONEncode(data))
	end)
	if not ok then
		warn("[NebulaUI] SaveConfig gagal: " .. tostring(err))
	end
	return ok
end

function Library:LoadConfig(name)
	name = name or "default"
	local ok, err = pcall(function()
		local path = CONFIG_DIR .. "/" .. name .. ".json"
		if not isfile(path) then
			error("file tidak ditemukan")
		end
		local data = HttpService:JSONDecode(readfile(path))
		for flag, value in pairs(data) do
			local item = self.Items[flag]
			if item then
				item:Set(decode(value))
			end
		end
	end)
	if not ok then
		warn("[NebulaUI] LoadConfig gagal: " .. tostring(err))
	end
	return ok
end

