function Elements:CreateSlider(cfg)
	cfg = cfg or {}
	local min, max = cfg.Min or 0, cfg.Max or 100
	local inc = cfg.Increment or 1
	local suffix = cfg.Suffix or ""
	local value = math.clamp(cfg.Default or min, min, max)

	local F, Top = baseElement(self, cfg, 100)
	local ValueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(90, 18),
		TextSize = 12,
		Weight = "Bold",
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = Top,
	})

	local Extra = makeExtra(F, 26)
	local Bar = create("Frame", {
		Position = UDim2.new(0, 14, 0, 6),
		Size = UDim2.new(1, -28, 0, 6),
		BackgroundColor3 = Theme.Track,
		Parent = Extra,
	})
	corner(Bar, 999)
	local Fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = Bar,
	})
	corner(Fill, 999)
	create("UIGradient", { Color = ColorSequence.new(Theme.Accent, Theme.Accent2), Parent = Fill })
	local Knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = Fill,
	})
	corner(Knob, 999)
	stroke(Knob, Theme.Accent, 2, 0)

	local function render(animate)
		local rel = (max == min) and 0 or (value - min) / (max - min)
		tween(Fill, { Size = UDim2.new(rel, 0, 1, 0) }, animate and EASE.Fast or EASE.Instant)
		ValueLabel.Text = tostring(value) .. suffix
	end

	local obj = {}
	function obj:Set(v, silent)
		v = math.clamp(round(tonumber(v) or min, inc), min, max)
		local changed = v ~= value
		value = v
		render(true)
		if cfg.Flag then
			Library.Flags[cfg.Flag] = value
		end
		if changed and not silent then
			safe(cfg.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	local Hit = create("TextButton", {
		Position = UDim2.new(0, 8, 0, 0),
		Size = UDim2.new(1, -16, 1, 0),
		ZIndex = 3,
		Parent = Extra,
	})
	dragInput(self._window, Hit, function(pos)
		local rel = math.clamp((pos.X - Bar.AbsolutePosition.X) / math.max(Bar.AbsoluteSize.X, 1), 0, 1)
		obj:Set(min + (max - min) * rel)
	end, function(active)
		tween(Knob, { Size = active and UDim2.fromOffset(19, 19) or UDim2.fromOffset(14, 14) }, EASE.Fast)
	end)

	register(cfg.Flag, obj, value)
	render(false)
	return obj
end

-- ───────────────────────── DROPDOWN ─────────────────────────
function Elements:CreateDropdown(cfg)
	cfg = cfg or {}
	local multi = cfg.Multi == true
	local options = cfg.Options or {}
	local value = multi and {} or nil
	local open = false
	local buttons = {}

	local F, Top = baseElement(self, cfg, 170)

	local Selected = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -38, 0.5, 0),
		Size = UDim2.fromOffset(130, 20),
		TextSize = 12,
		Weight = "Regular",
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = Top,
	})
	local Arrow = makeIcon(Top, "lucide:chevron-down", 18, Theme.SubText, "v", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -22, 0.5, 0),
	})

	local Extra = makeExtra(F, 0)
	local Holder = create("ScrollingFrame", {
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -24, 0, 0),
		BackgroundColor3 = Theme.Inset,
		BackgroundTransparency = 0.62,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Extra,
	})
	corner(Holder, 10)
	padding(Holder, 4, 4, 4, 4)
	listLayout(Holder, 2)

	local function isSelected(opt)
		if multi then
			return table.find(value, opt) ~= nil
		end
		return value == opt
	end

	local function paint()
		for opt, btn in pairs(buttons) do
			local on = isSelected(opt)
			tween(btn, {
				TextColor3 = on and Theme.Accent or Theme.Text,
				BackgroundTransparency = on and 0.86 or 1,
			}, EASE.Fast)
		end
	end

	local function display()
		if multi then
			local names = {}
			for _, o in ipairs(options) do
				if table.find(value, o) then
					table.insert(names, tostring(o))
				end
			end
			Selected.Text = #names > 0 and table.concat(names, ", ") or "None"
		else
			Selected.Text = value ~= nil and tostring(value) or "Select..."
		end
	end

	local function listHeight()
		return math.min(#options * 30 + 6, 150)
	end

	local function setOpen(state)
		open = state
		Holder.Size = UDim2.new(1, -24, 0, listHeight())
		tween(Extra, { Size = UDim2.new(1, 0, 0, state and (listHeight() + 12) or 0) }, EASE.Smooth)
		if Arrow then
			tween(Arrow, { Rotation = state and 180 or 0 }, EASE.Smooth)
			setIconColor(Arrow, state and Theme.Accent or Theme.SubText)
		end
	end

	local function commit(silent)
		display()
		paint()
		if cfg.Flag then
			Library.Flags[cfg.Flag] = value
		end
		if not silent then
			safe(cfg.Callback, value)
		end
	end

	local function build()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		buttons = {}
		for i, opt in ipairs(options) do
			local b = create("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = Theme.Accent,
				BackgroundTransparency = 1,
				Text = tostring(opt),
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = i,
				Parent = Holder,
			})
			corner(b, 8)
			padding(b, 10, 0, 6, 0)
			b.MouseEnter:Connect(function()
				if not isSelected(opt) then
					tween(b, { BackgroundTransparency = 0.94 }, EASE.Fast)
				end
			end)
			b.MouseLeave:Connect(function()
				if not isSelected(opt) then
					tween(b, { BackgroundTransparency = 1 }, EASE.Fast)
				end
			end)
			b.MouseButton1Click:Connect(function()
				if multi then
					local idx = table.find(value, opt)
					if idx then
						table.remove(value, idx)
					else
						table.insert(value, opt)
					end
				else
					value = opt
					setOpen(false)
				end
				commit()
			end)
			buttons[opt] = b
		end
	end

	local obj = {}
	function obj:Set(v, silent)
		if multi then
			value = type(v) == "table" and table.clone(v) or {}
		else
			value = v
		end
		commit(silent)
	end
	function obj:Get()
		return value
	end
	function obj:Refresh(newOptions, keep)
		options = newOptions or {}
		if not keep then
			value = multi and {} or nil
		end
		build()
		commit(true)
		if open then
			setOpen(true)
		end
	end

	local Click = create("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = Top })
	Click.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	build()
	if cfg.Default ~= nil then
		obj:Set(cfg.Default, true)
	else
		commit(true)
	end
	register(cfg.Flag, obj, value)
	return obj
end

