-- ───────────────────────── BUTTON ─────────────────────────
function Elements:CreateButton(cfg)
	cfg = cfg or {}
	local F, headerH, st = baseElement(self, cfg, 30)

	create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0, headerH / 2),
		Size = UDim2.fromOffset(20, 24),
		Text = "›",
		Font = Enum.Font.BuilderSansBold,
		TextSize = 22,
		TextColor3 = Theme.Accent,
		Parent = F,
	})

	local Click = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = F,
	})
	Click.InputBegan:Connect(function(input)
		if isPointer(input) then
			ripple(F, input)
		end
	end)
	Click.MouseButton1Click:Connect(function()
		st.Color = Theme.Accent
		tween(st, { Color = Theme.Stroke }, EASE.Slow)
		safe(cfg.Callback)
	end)

	local obj = {}
	function obj:SetText(t)
		F.Title.Text = t
	end
	return obj
end

-- ───────────────────────── TOGGLE ─────────────────────────
function Elements:CreateToggle(cfg)
	cfg = cfg or {}
	local value = cfg.Default == true
	local F, headerH = baseElement(self, cfg, 60)

	local Track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0, headerH / 2),
		Size = UDim2.fromOffset(40, 22),
		BackgroundColor3 = Theme.Track,
		Parent = F,
	})
	corner(Track, 999)
	local Glow = stroke(Track, Theme.Accent, 1.5, 1)

	local Knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = Track,
	})
	corner(Knob, 999)

	local function render(animate)
		local info = animate and EASE.Spring or EASE.Instant
		tween(Track, { BackgroundColor3 = value and Theme.Accent or Theme.Track },
			animate and EASE.Smooth or EASE.Instant)
		tween(Knob, {
			Position = value and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = value and Color3.new(1, 1, 1) or Color3.new(1, 1, 1),
		}, info)
		tween(Glow, { Transparency = value and 0.55 or 1 }, EASE.Smooth)
	end

	local obj = {}
	function obj:Set(v, silent)
		value = v == true
		render(true)
		if cfg.Flag then
			Library.Flags[cfg.Flag] = value
		end
		if not silent then
			safe(cfg.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	local Click = create("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = F })
	Click.MouseButton1Click:Connect(function()
		obj:Set(not value)
	end)
	-- knob "melebar" saat ditekan
	Click.MouseButton1Down:Connect(function()
		tween(Knob, { Size = UDim2.fromOffset(20, 16) }, EASE.Fast)
	end)
	Click.MouseButton1Up:Connect(function()
		tween(Knob, { Size = UDim2.fromOffset(16, 16) }, EASE.Fast)
	end)

	register(cfg.Flag, obj, value)
	render(false)
	return obj
end

-- ───────────────────────── SLIDER ─────────────────────────
function Elements:CreateSlider(cfg)
	cfg = cfg or {}
	local min, max = cfg.Min or 0, cfg.Max or 100
	local inc = cfg.Increment or 1
	local suffix = cfg.Suffix or ""
	local value = math.clamp(cfg.Default or min, min, max)
	local hasDesc = cfg.Description ~= nil

	local F, _, _, Title = baseElement(self, cfg, 90)
	local barY = hasDesc and 58 or 42
	F.Size = UDim2.new(1, 0, 0, barY + 16)
	Title.Position = UDim2.fromOffset(14, 8)
	Title.Size = UDim2.new(1, -110, 0, 18)

	local ValueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 8),
		Size = UDim2.fromOffset(90, 18),
		Font = Enum.Font.BuilderSansBold,
		TextSize = 13,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = F,
	})

	local Bar = create("Frame", {
		Position = UDim2.new(0, 14, 0, barY),
		Size = UDim2.new(1, -28, 0, 6),
		BackgroundColor3 = Theme.Track,
		Parent = F,
	})
	corner(Bar, 999)

	local Fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = Bar,
	})
	corner(Fill, 999)
	create("UIGradient", {
		Color = ColorSequence.new(Theme.Accent, Theme.Accent2),
		Parent = Fill,
	})

	local Knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = Fill,
	})
	corner(Knob, 999)
	stroke(Knob, Theme.Accent, 2, 0)

	local function render(animate)
		local rel = (max == min) and 0 or (value - min) / (max - min)
		tween(Fill, { Size = UDim2.new(rel, 0, 1, 0) }, animate and EASE.Fast or EASE.Instant)
		ValueLabel.Text = tostring(value) .. suffix
	end

	local obj = {}
	function obj:Set(v, silent)
		v = math.clamp(round(tonumber(v) or min, inc), min, max)
		local changed = v ~= value
		value = v
		render(true)
		if cfg.Flag then
			Library.Flags[cfg.Flag] = value
		end
		if changed and not silent then
			safe(cfg.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	local Hit = create("TextButton", {
		Position = UDim2.new(0, 8, 0, barY - 10),
		Size = UDim2.new(1, -16, 0, 26),
		ZIndex = 3,
		Parent = F,
	})
	dragInput(self._window, Hit, function(pos)
		local rel = math.clamp((pos.X - Bar.AbsolutePosition.X) / math.max(Bar.AbsoluteSize.X, 1), 0, 1)
		obj:Set(min + (max - min) * rel)
	end, function(active)
		tween(Knob, { Size = active and UDim2.fromOffset(19, 19) or UDim2.fromOffset(14, 14) }, EASE.Fast)
	end)

	register(cfg.Flag, obj, value)
	render(false)
	return obj
end

-- ───────────────────────── DROPDOWN ─────────────────────────
function Elements:CreateDropdown(cfg)
	cfg = cfg or {}
	local multi = cfg.Multi == true
	local options = cfg.Options or {}
	local value = multi and {} or nil
	local open = false
	local buttons = {}

	local F, headerH = baseElement(self, cfg, 150)

	local Selected = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -34, 0, headerH / 2),
		Size = UDim2.fromOffset(120, 20),
		Font = Enum.Font.BuilderSans,
		TextSize = 13,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = F,
	})
	local Arrow = create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -18, 0, headerH / 2),
		Size = UDim2.fromOffset(20, 20),
		Text = "›",
		Font = Enum.Font.BuilderSansBold,
		TextSize = 22,
		TextColor3 = Theme.SubText,
		Rotation = 90,
		Parent = F,
	})

	local Holder = create("ScrollingFrame", {
		Position = UDim2.new(0, 10, 0, headerH + 4),
		Size = UDim2.new(1, -20, 0, 0),
		BackgroundColor3 = Theme.Inset,
		BackgroundTransparency = 0.62,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = F,
	})
	corner(Holder, 6)
	padding(Holder, 4, 4, 4, 4)
	listLayout(Holder, 2)

	local function isSelected(opt)
		if multi then
			return table.find(value, opt) ~= nil
		end
		return value == opt
	end

	local function paint()
		for opt, btn in pairs(buttons) do
			local on = isSelected(opt)
			tween(btn, {
				TextColor3 = on and Theme.Accent or Theme.Text,
				BackgroundTransparency = on and 0.86 or 1,
			}, EASE.Fast)
		end
	end

	local function display()
		if multi then
			local names = {}
			for _, o in ipairs(options) do
				if table.find(value, o) then
					table.insert(names, tostring(o))
				end
			end
			Selected.Text = #names > 0 and table.concat(names, ", ") or "None"
		else
			Selected.Text = value ~= nil and tostring(value) or "Select..."
		end
	end

	local function listHeight()
		return math.min(#options * 30 + 6, 150)
	end

	local function setOpen(state)
		open = state
		local total = state and (headerH + 4 + listHeight() + 10) or headerH
		Holder.Size = UDim2.new(1, -20, 0, listHeight())
		tween(F, { Size = UDim2.new(1, 0, 0, total) }, EASE.Smooth)
		tween(Arrow, { Rotation = state and 270 or 90, TextColor3 = state and Theme.Accent or Theme.SubText }, EASE.Smooth)
	end

	local function commit(silent)
		display()
		paint()
		if cfg.Flag then
			Library.Flags[cfg.Flag] = value
		end
		if not silent then
			safe(cfg.Callback, value)
		end
	end

	local function build()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		buttons = {}
		for i, opt in ipairs(options) do
			local b = create("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = Theme.Accent,
				BackgroundTransparency = 1,
				Text = tostring(opt),
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = i,
				Parent = Holder,
			})
			corner(b, 5)
			padding(b, 10, 0, 6, 0)
			b.MouseEnter:Connect(function()
				if not isSelected(opt) then
					tween(b, { BackgroundTransparency = 0.94 }, EASE.Fast)
				end
			end)
			b.MouseLeave:Connect(function()
				if not isSelected(opt) then
					tween(b, { BackgroundTransparency = 1 }, EASE.Fast)
				end
			end)
			b.MouseButton1Click:Connect(function()
				if multi then
					local idx = table.find(value, opt)
					if idx then
						table.remove(value, idx)
					else
						table.insert(value, opt)
					end
				else
					value = opt
					setOpen(false)
				end
				commit()
			end)
			buttons[opt] = b
		end
	end

	local obj = {}
	function obj:Set(v, silent)
		if multi then
			value = type(v) == "table" and table.clone(v) or {}
		else
			value = v
		end
		commit(silent)
	end
	function obj:Get()
		return value
	end
	function obj:Refresh(newOptions, keep)
		options = newOptions or {}
		if not keep then
			value = multi and {} or nil
		end
		build()
		commit(true)
		if open then
			setOpen(true)
		end
	end

	local Click = create("TextButton", {
		Size = UDim2.new(1, 0, 0, headerH),
		ZIndex = 3,
		Parent = F,
	})
	Click.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	build()
	if cfg.Default ~= nil then
		obj:Set(cfg.Default, true)
	else
		commit(true)
	end
	register(cfg.Flag, obj, value)
	return obj
end

-- ───────────────────────── TEXTBOX ─────────────────────────
function Elements:CreateTextBox(cfg)
	cfg = cfg or {}
	local value = cfg.Default or ""
	local F, headerH = baseElement(self, cfg, 160)

	local Box = create("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0, headerH / 2),
		Size = UDim2.fromOffset(150, 26),
		BackgroundColor3 = Theme.Inset,
		BackgroundTransparency = 0.6,
		Text = value,
		PlaceholderText = cfg.Placeholder or "Type here...",
		PlaceholderColor3 = Theme.SubText,
		ClearTextOnFocus = false,
		ClipsDescendants = true,
		Font = Enum.Font.BuilderSans,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = F,
	})
	corner(Box, 6)
	padding(Box, 8, 0, 8, 0)
	local bs = stroke(Box, Theme.Stroke, 1, 0.84)

	Box.Focused:Connect(function()
		tween(bs, { Color = Theme.Accent }, EASE.Fast)
	end)

	local obj = {}
	function obj:Set(v, silent)
		value = tostring(v)
		Box.Text = value
		if cfg.Flag then
			Library.Flags[cfg.Flag] = value
		end
		if not silent then
			safe(cfg.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	Box.FocusLost:Connect(function()
		tween(bs, { Color = Theme.Stroke }, EASE.Smooth)
		local text = Box.Text
		if cfg.Numeric then
			local n = tonumber(text)
			text = n and tostring(n) or value
		end
		obj:Set(text)
	end)

	register(cfg.Flag, obj, value)
	return obj
end

-- ───────────────────────── KEYBIND ─────────────────────────
function Elements:CreateKeybind(cfg)
	cfg = cfg or {}
	local key = cfg.Default or Enum.KeyCode.Unknown
	local listening = false
	local F, headerH = baseElement(self, cfg, 100)

	local Btn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0, headerH / 2),
		Size = UDim2.fromOffset(84, 26),
		BackgroundColor3 = Theme.Inset,
		BackgroundTransparency = 0.6,
		Font = Enum.Font.BuilderSansBold,
		TextSize = 12,
		TextColor3 = Theme.Accent,
		ZIndex = 3,
		Parent = F,
	})
	corner(Btn, 6)
	local bs = stroke(Btn, Theme.Stroke, 1, 0.84)

	local function label()
		Btn.Text = key == Enum.KeyCode.Unknown and "None" or key.Name
	end
	label()

	local obj = {}
	function obj:Set(k, silent)
		if typeof(k) == "string" then
			k = Enum.KeyCode[k]
		end
		key = k or Enum.KeyCode.Unknown
		label()
		if cfg.Flag then
			Library.Flags[cfg.Flag] = key
		end
		if not silent then
			safe(cfg.Changed, key)
		end
	end
	function obj:Get()
		return key
	end

	Btn.MouseButton1Click:Connect(function()
		listening = true
		Btn.Text = "..."
		tween(bs, { Color = Theme.Accent }, EASE.Fast)
	end)

	self._window:_track(UserInputService.InputBegan:Connect(function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				tween(bs, { Color = Theme.Stroke }, EASE.Smooth)
				if input.KeyCode == Enum.KeyCode.Escape then
					label()
				else
					obj:Set(input.KeyCode)
				end
			end
		elseif not gp and key ~= Enum.KeyCode.Unknown and input.KeyCode == key then
			safe(cfg.Callback, key)
		end
	end))

	register(cfg.Flag, obj, key)
	return obj
end

