local function getNotifHolder()
	if Library._notifHolder and Library._notifHolder.Parent then
		return Library._notifHolder
	end
	local gui = create("ScreenGui", {
		Name = "NebulaUI_Notifications",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 1000,
	})
	mountGui(gui)
	local holder = create("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 300, 1, -32),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 0),
		Parent = holder,
	})
	Library._notifHolder = holder
	return holder
end

function Library:Notify(cfg)
	cfg = cfg or {}
	local holder = getNotifHolder()
	local colors = {
		Info = Theme.Accent,
		Success = Theme.Success,
		Warning = Theme.Warning,
		Error = Theme.Danger,
	}
	local accent = colors[cfg.Type or "Info"] or Theme.Accent
	local duration = cfg.Duration or 4

	Library._nid += 1
	local Wrap = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		LayoutOrder = Library._nid,
		Parent = holder,
	})
	local Card = create("Frame", {
		Position = UDim2.new(1.25, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 68),
		BackgroundColor3 = Theme.Glass,
		BackgroundTransparency = 0.08,
		ClipsDescendants = true,
		Parent = Wrap,
	})
	corner(Card, 14)
	stroke(Card, Theme.Stroke, 1, 0.82)

	local Edge = create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = accent,
		Parent = Card,
	})
	create("TextLabel", {
		Position = UDim2.fromOffset(16, 9),
		Size = UDim2.new(1, -28, 0, 16),
		Text = cfg.Title or "Notification",
		Font = Enum.Font.BuilderSansBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = Card,
	})
	create("TextLabel", {
		Position = UDim2.fromOffset(16, 27),
		Size = UDim2.new(1, -28, 0, 32),
		Text = cfg.Content or "",
		Font = Enum.Font.BuilderSans,
		TextSize = 13,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Parent = Card,
	})
	local Bar = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = accent,
		Parent = Card,
	})

	task.spawn(function()
		tween(Wrap, { Size = UDim2.new(1, 0, 0, 76) }, EASE.Smooth)
		task.wait(0.12)
		tween(Card, { Position = UDim2.new(0, 0, 0, 0) }, EASE.Spring)
		tween(Bar, { Size = UDim2.new(0, 0, 0, 2) }, TweenInfo.new(duration, Enum.EasingStyle.Linear))
		task.wait(duration)
		tween(Card, { Position = UDim2.new(1.25, 0, 0, 0) },
			TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In)).Completed:Wait()
		tween(Wrap, { Size = UDim2.new(1, 0, 0, 0) }, EASE.Smooth).Completed:Wait()
		Wrap:Destroy()
	end)
end

----------------------------------------------------------------------
-- ELEMENTS (dipakai oleh Tab & Section)
----------------------------------------------------------------------
local Elements = {}
Elements.__index = Elements

function Elements:_next()
	self._order = (self._order or 0) + 1
	return self._order
end

-- Kerangka dasar tiap elemen. Return: frame, headerHeight, stroke, titleLabel
local function baseElement(self, cfg, rightWidth)
	local hasDesc = cfg.Description ~= nil
	local headerH = hasDesc and 52 or 40
	local rw = rightWidth or 0

	local F = create("Frame", {
		Name = cfg.Name or "Element",
		Size = UDim2.new(1, 0, 0, headerH),
		BackgroundColor3 = Theme.Element,
		BackgroundTransparency = Theme.ElementAlpha,
		ClipsDescendants = true,
		LayoutOrder = self:_next(),
		Parent = self._parent,
	})
	corner(F, 12)
	local st = stroke(F, Theme.Stroke, 1, 0.88)

	local Title = create("TextLabel", {
		Name = "Title",
		Position = UDim2.fromOffset(14, hasDesc and 8 or 0),
		Size = UDim2.new(1, -(rw + 28), 0, hasDesc and 16 or 40),
		Text = cfg.Name or "Element",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = F,
	})
	if hasDesc then
		create("TextLabel", {
			Name = "Desc",
			Position = UDim2.fromOffset(14, 26),
			Size = UDim2.new(1, -(rw + 28), 0, 16),
			Text = cfg.Description,
			Font = Enum.Font.BuilderSans,
			TextSize = 12,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = F,
		})
	end

	F.MouseEnter:Connect(function()
		tween(F, { BackgroundTransparency = Theme.ElementHoverAlpha }, EASE.Fast)
		tween(st, { Transparency = 0.7 }, EASE.Fast)
	end)
	F.MouseLeave:Connect(function()
		tween(F, { BackgroundTransparency = Theme.ElementAlpha }, EASE.Fast)
		tween(st, { Transparency = 0.88 }, EASE.Fast)
	end)

	return F, headerH, st, Title
end

local function register(flag, obj, value)
	if flag then
		Library.Flags[flag] = value
		Library.Items[flag] = obj
	end
end

-- Drag helper untuk slider / color picker
local function dragInput(window, frame, onMove, onState)
	local active = false
	frame.InputBegan:Connect(function(input)
		if isPointer(input) then
			active = true
			if onState then
				onState(true)
			end
			onMove(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	window:_track(UserInputService.InputChanged:Connect(function(input)
		if active and isMove(input) then
			onMove(Vector2.new(input.Position.X, input.Position.Y))
		end
	end))
	window:_track(UserInputService.InputEnded:Connect(function(input)
		if active and isPointer(input) then
			active = false
			if onState then
				onState(false)
			end
		end
	end))
end

