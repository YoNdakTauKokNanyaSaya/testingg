		tween(Knob, { Size = UDim2.fromOffset(22, 18) }, EASE.Fast)
	end)
	Click.MouseButton1Up:Connect(function()
		tween(Knob, { Size = UDim2.fromOffset(18, 18) }, EASE.Fast)
	end)

	register(cfg.Flag, obj, value)
	render(false)
	return obj
