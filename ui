	padding(TabList, 10, 10, 10, 6)
	listLayout(TabList, 4)
	Window._TabList = TabList

	-- Profil pemain
	local Profile = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -20, 0, 44),
		BackgroundColor3 = Theme.Element,
		BackgroundTransparency = 0.9,
		Parent = Sidebar,
	})
	corner(Profile, 14)
	stroke(Profile, Theme.Stroke, 1, 0.88)
	local Avatar = create("ImageLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 7, 0.5, 0),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = Theme.Track,
		BackgroundTransparency = 0,
		Parent = Profile,
	})
	corner(Avatar, 999)
	stroke(Avatar, Theme.Accent, 1.5, 0.2)
	create("TextLabel", {
		Position = UDim2.fromOffset(44, 6),
		Size = UDim2.new(1, -50, 0, 16),
		Text = LocalPlayer.DisplayName,
		Font = Enum.Font.BuilderSansBold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = Profile,
	})
	create("TextLabel", {
		Position = UDim2.fromOffset(44, 22),
		Size = UDim2.new(1, -50, 0, 14),
		Text = "@" .. LocalPlayer.Name,
		Font = Enum.Font.BuilderSans,
		TextSize = 11,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = Profile,
	})
	task.spawn(function()
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(
				LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok then
			Avatar.Image = img
		end
	end)

	local Content = create("Frame", {
		Position = UDim2.fromOffset(sideW + 1, 0),
		Size = UDim2.new(1, -(sideW + 1), 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = Body,
	})
	padding(Content, 12, 12, 6, 12)
	Window._Content = Content

	-- Rim: tepi kaca yang berkilau (terang di sudut kiri-atas & kanan-bawah)
	local Rim = create("Frame", {
		Name = "Rim",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 10,
		Parent = Main,
	})
	corner(Rim, 18)
	local RimStroke = stroke(Rim, Color3.new(1, 1, 1), 1.4, 0)
	create("UIGradient", {
		Rotation = 45,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.4),
			NumberSequenceKeypoint.new(0.5, 0.92),
			NumberSequenceKeypoint.new(1, 0.62),
		}),
		Parent = RimStroke,
	})

	----------------------------------------------------------------
	-- Window behaviour
	----------------------------------------------------------------
	makeDraggable(Window, TopBar, Main)

	function Window:_fullSize()
		return UDim2.fromOffset(W, self._curH)
	end

	function Window:SetVisible(state)
		self._visible = state
		self:_setBlur(state)
		if state then
			Main.Visible = true
			Main.Size = UDim2.fromOffset(W * 0.92, self._curH * 0.92)
			tween(Main, { Size = self:_fullSize(), GroupTransparency = 0 }, EASE.Spring)
		else
			tween(Main, {
				Size = UDim2.fromOffset(W * 0.92, self._curH * 0.92),
				GroupTransparency = 1,
			}, EASE.Smooth)
			task.delay(0.3, function()
				if not self._visible then
					Main.Visible = false
				end
			end)
		end
	end

	function Window:Toggle()
		self:SetVisible(not self._visible)
	end

	function Window:Minimize()
		self._minimized = not self._minimized
		self:_setBlur(not self._minimized)
		local newH = self._minimized and TOP_H + 1 or H
		local dh = newH - self._curH
		self._curH = newH
		local p = Main.Position
		if not self._minimized then
			Body.Visible = true
		end
		tween(Main, {
			Size = UDim2.fromOffset(W, newH),
			Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + dh / 2),
		}, EASE.Smooth)
		if self._minimized then
			task.delay(0.28, function()
				if self._minimized then
					Body.Visible = false
				end
			end)
		end
	end

	function Window:Destroy()
		for _, c in ipairs(self._conns) do
			c:Disconnect()
		end
		self:_setBlur(false)
		tween(Main, {
			Size = UDim2.fromOffset(W * 0.88, self._curH * 0.88),
			GroupTransparency = 1,
		}, EASE.Smooth)
		task.delay(0.32, function()
			Gui:Destroy()
			Blur:Destroy()
		end)
	end

	function Window:Notify(opts)
		Library:Notify(opts)
	end

	MinBtn.MouseButton1Click:Connect(function()
		Window:Minimize()
	end)
	CloseBtn.MouseButton1Click:Connect(function()
		Window:Destroy()
	end)

	-- Toggle key
	local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	Window:_track(UserInputService.InputBegan:Connect(function(input, gp)
		if not gp and input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	-- Tombol mengambang untuk mobile
	if cfg.FloatingButton ~= false and UserInputService.TouchEnabled then
		local Float = create("TextButton", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, 0),
			Size = UDim2.fromOffset(44, 44),
			BackgroundColor3 = Theme.Glass,
			BackgroundTransparency = 0.12,
			Text = string.upper(string.sub(cfg.Title or "N", 1, 1)),
			Font = Enum.Font.BuilderSansExtraBold,
			TextSize = 18,
			TextColor3 = Theme.Accent,
			Parent = Gui,
		})
		corner(Float, 22)
		stroke(Float, Theme.Accent, 1.5, 0.2)
		Float.MouseButton1Click:Connect(function()
			Window:Toggle()
		end)
	end

	-- Animasi masuk
	Main.Visible = true
	tween(Main, { Size = UDim2.fromOffset(W, H), GroupTransparency = 0 }, EASE.Spring)
	Window:_setBlur(true)

	----------------------------------------------------------------
	-- TAB
	----------------------------------------------------------------
	function Window:CreateTab(name, icon)
		local Tab = setmetatable({ _window = self, _order = 0, Name = name }, Elements)

		local Btn = create("TextButton", {
			Name = name,
			Size = UDim2.new(1, 0, 0, 36),
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = 1,
			LayoutOrder = #self.Tabs + 1,
			Parent = self._TabList,
		})
		corner(Btn, 10)
		local Bar = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(3, 0),
			BackgroundColor3 = Theme.Accent,
			Parent = Btn,
		})
		corner(Bar, 3)

		local Icon
		if icon and icon ~= "" then
			Icon = create("ImageLabel", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 12, 0.5, 0),
				Size = UDim2.fromOffset(18, 18),
				Image = icon,
				ImageColor3 = Theme.SubText,
				Parent = Btn,
			})
		else
			Icon = create("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 17, 0.5, 0),
				Size = UDim2.fromOffset(6, 6),
				BackgroundColor3 = Theme.SubText,
				Parent = Btn,
			})
			corner(Icon, 999)
		end
		local function iconColor(c)
			if Icon:IsA("ImageLabel") then
				tween(Icon, { ImageColor3 = c }, EASE.Smooth)
			else
				tween(Icon, { BackgroundColor3 = c }, EASE.Smooth)
			end
		end

		local Label = create("TextLabel", {
			Position = UDim2.fromOffset(40, 0),
			Size = UDim2.new(1, -46, 1, 0),
			Text = name,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = Btn,
		})

		local Page = create("CanvasGroup", {
			Name = name,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			GroupTransparency = 1,
			Visible = false,
			Parent = self._Content,
		})
		local Scroll = create("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Accent,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Parent = Page,
		})
		padding(Scroll, 0, 0, 8, 4)
		listLayout(Scroll, 8)
		Tab._parent = Scroll

		function Tab:_select()
			Page.Visible = true
			Page.Position = UDim2.fromOffset(0, 18)
			Page.GroupTransparency = 1
			tween(Page, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, EASE.Smooth)
			tween(Btn, { BackgroundTransparency = 0.78 }, EASE.Smooth)
			tween(Bar, { Size = UDim2.fromOffset(3, 18) }, EASE.Spring)
			tween(Label, { TextColor3 = Theme.Text }, EASE.Smooth)
			iconColor(Theme.Accent)
		end
		function Tab:_deselect()
			Page.Visible = false
			tween(Btn, { BackgroundTransparency = 1 }, EASE.Smooth)
			tween(Bar, { Size = UDim2.fromOffset(3, 0) }, EASE.Smooth)
			tween(Label, { TextColor3 = Theme.SubText }, EASE.Smooth)
			iconColor(Theme.SubText)
		end

		Btn.MouseEnter:Connect(function()
			if self._active ~= Tab then
				tween(Btn, { BackgroundTransparency = 0.94 }, EASE.Fast)
			end
		end)
		Btn.MouseLeave:Connect(function()
			if self._active ~= Tab then
				tween(Btn, { BackgroundTransparency = 1 }, EASE.Fast)
			end
		end)
		Btn.MouseButton1Click:Connect(function()
			self:SelectTab(Tab)
		end)

		table.insert(self.Tabs, Tab)
		if not self._active then
			self:SelectTab(Tab)
		end
		return Tab
	end

	function Window:SelectTab(tab)
		if self._active == tab then
			return
		end
		if self._active then
			self._active:_deselect()
		end
		self._active = tab
		tab:_select()
	end

	return Window
end

return Library
