		BackgroundColor3 = color,
		Parent = F,
	})
	corner(Swatch, 5)
	stroke(Swatch, Color3.new(1, 1, 1), 1, 0.7)

	-- Saturation / Value box
	local SV = create("Frame", {
		Position = UDim2.new(0, 14, 0, headerH + 6),
		Size = UDim2.new(1, -62, 0, PICK_H),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		ClipsDescendants = true,
		Parent = F,
	})
	corner(SV, 6)
	local White = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = SV,
	})
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = White,
	})
	local Black = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		Parent = SV,
	})
	create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = Black,
	})
	local SVCursor = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = SV,
	})
	corner(SVCursor, 999)
	stroke(SVCursor, Color3.new(1, 1, 1), 2, 0)

	-- Hue bar
	local HueBar = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, headerH + 6),
		Size = UDim2.fromOffset(20, PICK_H),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = F,
	})
	corner(HueBar, 6)
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 == 1 and 0.999 or i / 6, 1, 1)))
	end
	create("UIGradient", { Rotation = 90, Color = ColorSequence.new(keys), Parent = HueBar })
	local HueCursor = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, 4, 0, 5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = HueBar,
	})
	corner(HueCursor, 3)
	stroke(HueCursor, Color3.fromRGB(20, 20, 30), 1, 0.2)

	local obj = {}
	local function refresh(silent)
		color = Color3.fromHSV(h, s, v)
		SV.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		SVCursor.Position = UDim2.fromScale(s, 1 - v)
		HueCursor.Position = UDim2.fromScale(0.5, h)
		tween(Swatch, { BackgroundColor3 = color }, EASE.Fast)
		Hex.Text = "#" .. color:ToHex():upper()
		if cfg.Flag then
			Library.Flags[cfg.Flag] = color
		end
		if not silent then
			safe(cfg.Callback, color)
		end
	end

	function obj:Set(c, silent)
		h, s, v = c:ToHSV()
		refresh(silent)
	end
	function obj:Get()
		return color
	end

	dragInput(self._window, SV, function(pos)
		s = math.clamp((pos.X - SV.AbsolutePosition.X) / math.max(SV.AbsoluteSize.X, 1), 0, 1)
		v = 1 - math.clamp((pos.Y - SV.AbsolutePosition.Y) / math.max(SV.AbsoluteSize.Y, 1), 0, 1)
		refresh()
	end)
	dragInput(self._window, HueBar, function(pos)
		h = math.clamp((pos.Y - HueBar.AbsolutePosition.Y) / math.max(HueBar.AbsoluteSize.Y, 1), 0, 0.999)
		refresh()
	end)

	local Click = create("TextButton", {
		Size = UDim2.new(1, 0, 0, headerH),
		ZIndex = 4,
		Parent = F,
	})
	Click.MouseButton1Click:Connect(function()
		open = not open
		tween(F, { Size = UDim2.new(1, 0, 0, open and (headerH + PICK_H + 18) or headerH) }, EASE.Smooth)
	end)

	register(cfg.Flag, obj, color)
	refresh(true)
	return obj
end

