local Elements = {}
Elements.__index = Elements

function Elements:_next()
	self._order = (self._order or 0) + 1
	return self._order
end

--[[
	Kerangka elemen (card kaca, tinggi otomatis):
	  F (card)
	   ├─ Top   : [Teks: judul + deskripsi (wrap)]   [kontrol di kanan]
	   └─ Extra : area tambahan (slider bar, list dropdown, color picker)
]]
local function baseElement(self, cfg, rightWidth, minH)
	local F = create("Frame", {
		Name = cfg.Name or "Element",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Element,
		BackgroundTransparency = Theme.ElementAlpha,
		ClipsDescendants = true,
		LayoutOrder = self:_next(),
		Parent = self._parent,
	})
	corner(F, 14)
	local st = stroke(F, Theme.Stroke, 1, 0.88)
	listLayout(F, 0)

	local Top = create("Frame", {
		Name = "Top",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = F,
	})
	create("UISizeConstraint", { MinSize = Vector2.new(0, minH or 52), Parent = Top })

	local Text = create("Frame", {
		Name = "Text",
		Size = UDim2.new(1, -(rightWidth or 0), 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = Top,
	})
	padding(Text, 14, 12, 8, 12)
	listLayout(Text, 4)

	local Title = create("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = cfg.Name or "Element",
		TextSize = 13,
		Weight = "Bold",
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 1,
		Parent = Text,
	})
	if cfg.Description then
		create("TextLabel", {
			Name = "Desc",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = cfg.Description,
			TextSize = 12,
			Weight = "Regular",
			TextColor3 = Theme.SubText,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = 2,
			Parent = Text,
		})
	end

	F.MouseEnter:Connect(function()
		tween(F, { BackgroundTransparency = Theme.ElementHoverAlpha }, EASE.Fast)
		tween(st, { Transparency = 0.7 }, EASE.Fast)
	end)
	F.MouseLeave:Connect(function()
		tween(F, { BackgroundTransparency = Theme.ElementAlpha }, EASE.Fast)
		tween(st, { Transparency = 0.88 }, EASE.Fast)
	end)

	return F, Top, st, Title
end

local function makeExtra(F, height)
	return create("Frame", {
		Name = "Extra",
		Size = UDim2.new(1, 0, 0, height or 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = 2,
		Parent = F,
	})
end

local function register(flag, obj, value)
	if flag then
		Library.Flags[flag] = value
		Library.Items[flag] = obj
	end
end

local function dragInput(window, frame, onMove, onState)
	local active = false
	frame.InputBegan:Connect(function(input)
		if isPointer(input) then
			active = true
			if onState then
				onState(true)
			end
			onMove(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	window:_track(UserInputService.InputChanged:Connect(function(input)
		if active and isMove(input) then
			onMove(Vector2.new(input.Position.X, input.Position.Y))
		end
	end))
	window:_track(UserInputService.InputEnded:Connect(function(input)
		if active and isPointer(input) then
			active = false
			if onState then
				onState(false)
			end
		end
	end))
end

