function Elements:CreateToggle(cfg)
	cfg = cfg or {}
	local value = cfg.Default == true
	local F, Top = baseElement(self, cfg, 70)

	local Track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
